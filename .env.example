# =============================================
# AI / Anthropic
# =============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================
# Supabase (database)
# =============================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================
# Google Calendar (optional)
# =============================================
GOOGLE_CLIENT_EMAIL=your_google_client_email_here
GOOGLE_PRIVATE_KEY=your_google_private_key_here
GOOGLE_CALENDAR_ID=your_google_calendar_id_here

# =============================================
# Twilio — Voice & WhatsApp
# =============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=+1XXXXXXXXXX

# =============================================
# Application URLs
# =============================================
# Public-facing base URL (used for Twilio webhook validation and TwiML callbacks)
APP_BASE_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# WebSocket URL for the voice ConversationRelay server (deployed separately on Railway)
# Format: wss://your-voice-server.railway.app/api/voice/ws
VOICE_WS_URL=wss://your-voice-server.railway.app/api/voice/ws

# =============================================
# Human escalation
# =============================================
# Phone number to transfer calls to when AI escalates (E.164 format)
HUMAN_TRANSFER_NUMBER=+1XXXXXXXXXX

# =============================================
# Security
# =============================================
# Shared secret for the outbound calling endpoint (POST /api/voice/outbound)
# Generate with: openssl rand -hex 32
OUTBOUND_CALL_SECRET=your_secret_here

# =============================================
# Clinic Configuration
# =============================================
CLINIC_NAME=Smile Dental Clinic
CLINIC_ADDRESS=123 Main Street, City, State ZIP
CLINIC_PHONE=+1-555-123-4567
CLINIC_EMAIL=contact@smiledentalclinic.com
CLINIC_TIMEZONE=America/New_York
CLINIC_OPENING_TIME=09:00
CLINIC_CLOSING_TIME=19:00
CLINIC_BREAK_START=13:00
CLINIC_BREAK_END=14:00

# Admin Configuration
ADMIN_EMAIL=admin@smiledentalclinic.com

# =============================================
# Voice WebSocket Server (voice-server/index.ts)
# Set these when running the standalone voice server on Railway
# =============================================
VOICE_WS_PORT=8080
